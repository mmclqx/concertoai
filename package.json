{
  "name": "@concertoai/cli",
  "version": "4.0.1",
  "description": "ConcertoAI —— 面向个人开发者的中文优先终端编码助手 CLI（DeepSeek 驱动）",
  "type": "module",
  "license": "MIT",
  "author": "mmclqx",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "concertoai": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build && npm run lint && npm run typecheck && npm run test -- --silent",
    "prepublishOnly": "npm run verify",
    "version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "tiktoken": "^1.0.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
